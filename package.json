{
    "name": "templater",
    "version": "0.0.1",
    "description": "Turn ServiceNow records into formatted PDFs and slide decks.",
    "license": "UNLICENSED",
    "imports": {
        "#now:*": "./@types/servicenow/fluent/*/index.js"
    },
    "scripts": {
        "starters": "node scripts/build-starters.mjs",
        "fonts": "node scripts/build-fonts.mjs",
        "build": "npm run starters && npm run fonts && now-sdk build",
        "deploy": "now-sdk install",
        "transform": "now-sdk transform",
        "types": "now-sdk dependencies",
        "dev": "npm run fonts && now-sdk run dev",
        "typecheck": "npm run fonts && tsc -p src/client --noEmit && tsc -p src/client/tsconfig.test.json --noEmit && tsc -p src/server --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm run fonts && vitest run",
        "test:watch": "vitest",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
    },
    "devDependencies": {
        "@eslint/js": "9.32.0",
        "@servicenow/glide": "27.0.5",
        "@servicenow/isomorphic-rollup": "^1.3.11",
        "@servicenow/sdk": "4.13.6",
        "@types/d3": "7",
        "@types/node": "22.16.5",
        "@types/react": "19.x",
        "@types/react-dom": "19.x",
        "eslint": "9.32.0",
        "eslint-plugin-react-hooks": "5.2.0",
        "globals": "16.3.0",
        "prettier": "3.6.2",
        "typescript": "5.5.4",
        "typescript-eslint": "8.38.0",
        "vitest": "3.2.4"
    },
    "dependencies": {
        "d3": "^7.9.0",
        "react": "19.x",
        "react-dom": "19.x"
    }
}
